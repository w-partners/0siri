{
  "expo": {
    "name": "0Siri",
    "slug": "osiri",
    "scheme": "osiri",
    "version": "0.3.1",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.osiri.mobile"
    },
    "android": {
      "package": "app.osiri.mobile",
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"]
    },
    "web": {
      "bundler": "metro",
      "name": "0Siri"
    },
    "plugins": [
      "expo-document-picker",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
