{
  "expo": {
    "name": "0Siri",
    "slug": "osiri",
    "scheme": "osiri",
    "version": "0.15.1",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.osiri.mobile"
    },
    "android": {
      "package": "app.osiri.mobile",
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "openagentx.org",
              "pathPrefix": "/invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "0Siri"
    },
    "plugins": [
      "expo-document-picker",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/with-onnxruntime-version"
    ]
  }
}
