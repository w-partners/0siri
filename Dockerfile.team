# 팀 런타임 이미지 (0SIRI-SPEC §15.3). 서버와 같은 코드, 다른 CMD(team-entry).
# 빌드: docker build -f Dockerfile.team -t osiri/team-runtime .
# 실행 환경변수는 서버 프로비저너가 env-file 로 넣는다 (OSIRI_API_URL·OSIRI_WORKER_TOKEN·TEAM_YAML·모델 키).
FROM node:22-slim
RUN npm install -g pnpm@11 --silent
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
# 루트(서버) 의존성만. 모바일·브라우저 워커는 제외, 네이티브 빌드(onnxruntime 등)도 팀 런타임엔 불필요
RUN pnpm install --frozen-lockfile --ignore-scripts --filter openmuse
COPY apps/server ./apps/server
COPY packages ./packages
COPY teams ./teams
COPY tsconfig.json ./
ENV NODE_ENV=production
CMD ["pnpm", "exec", "tsx", "apps/server/src/osiri/team-entry.ts"]
