# Copy to .env. Sample mode stays on localhost and uses fictional data.
# Every mode requires a server-only CopilotKit Intelligence project key.
WORKSPACE_MODE=sample
AGENT_BACKEND=sample
PORT=8787
HOST=127.0.0.1
# 공개 배포는 https://openagentx.org (cloudflared 터널 osiri-seoul → :8788)
PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DATA_DIR=.openmuse
TASK_WORKER_ENABLED=true
# Rate limiting keys on the socket address. Set true only behind a reverse proxy that
# overwrites X-Forwarded-For; otherwise callers can spoof it.
# TRUST_PROXY=false

# General delegated work: select AGENT_BACKEND=model and a provider/model.
# MODEL=openai/your-model-id
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# Keyless public web search is enabled by default. Queries and task/chat context go to Parallel.
# Disable on the API and any separate task worker with WEB_SEARCH_ENABLED=false.
WEB_SEARCH_ENABLED=true
# Optional OpenAI-compatible Responses API endpoint:
# OPENAI_BASE_URL=
# Optional Anthropic endpoint override; a trailing /v1 is stripped (the SDK adds /v1 itself):
# ANTHROPIC_BASE_URL=
# Optional Google AI endpoint override; a trailing /v1beta is stripped (the SDK adds /v1beta itself):
# GOOGLE_GENERATIVE_AI_BASE_URL=
# For a gateway model ID such as vendor/model, set MODEL=openai/vendor/model.
# Providers whose /responses tool loop is incomplete (e.g. DeepSeek) can opt
# into the Chat Completions wire format instead:
# OPENAI_CHAT_COMPLETIONS=true

# Live Google workspace: WORKSPACE_MODE=live, AGENT_BACKEND=model.
# OPENMUSE_ACCESS_KEY=  # random secret, at least 24 characters
# TOKEN_ENCRYPTION_KEY=  # 32 random bytes encoded as base64
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAuth callback is PUBLIC_API_URL + /api/google/callback

# Optional separate task worker; all processes share DATA_DIR for PDF files.
# DATABASE_URL=postgresql://...
# Set TASK_WORKER_ENABLED=false on the API when using pnpm dev:worker.

# Browser worker (separate from the task worker):
# BROWSER_WORKER_URL=http://127.0.0.1:8790
# WORKER_TOKEN=  # same random 32+ character secret in API and browser worker
WORKER_DATA_DIR=.openmuse/browser-profiles
WORKER_HOST=127.0.0.1

# An optional external raw AG-UI agent replaces conversational routing only.
# AGENT_BACKEND=agui
# AGENT_URL=https://your-agent.example/run
# AGENT_TOKEN=
# OpenBot's Intelligence runtime is not this raw AG-UI URL. See its adapter docs.

# CopilotKit Intelligence is required in every mode. Create or select a project
# with the commands below, then keep the generated key server-only.
# npx copilotkit@latest login
# npx copilotkit@latest project select
CPK_INTELLIGENCE_API_KEY=

# CopilotKit SDK telemetry goes through the shared sink to PostHog, tagged OpenMuse.
# project select also writes CPK_TELEMETRY_ID: preserve that generated value and
# deploy it alongside CPK_INTELLIGENCE_API_KEY to link runtime usage to the account.
# Do not invent an identity or copy one from another project.
# CPK_TELEMETRY_ID=  # generated by the CLI; keep server-only
# Full funnel capture is the default; an explicit sample rate overrides it.
# COPILOTKIT_TELEMETRY_SAMPLE_RATE=1
# Opt out of SDK telemetry with either flag (true or 1), then restart the API:
# COPILOTKIT_TELEMETRY_DISABLED=true
# DO_NOT_TRACK=1

# Optional private Docker Linux computer (separate from the browser).
# Build first: docker build -t openmuse-computer:local apps/computer
# Docker must be reachable from the API and any separate task worker.
COMPUTER_ENABLED=false
COMPUTER_IMAGE=openmuse-computer:local
# Stable deployment name shared by API and worker; defaults to a hash of PUBLIC_API_URL.
# COMPUTER_DEPLOYMENT_ID=my-openmuse
# Optional scoped Docker engine, e.g. DOCKER_CONTEXT=colima-openmuse
# Or run each owner's computer in an E2B Desktop sandbox instead of Docker
# (graphical desktop with internet access; see docs/COMPUTER.md):
# COMPUTER_PROVIDER=e2b-desktop  # default: docker
# E2B_API_KEY=  # server-only; required for e2b-desktop, never sent into the sandbox
# COMPUTER_DEPLOYMENT_ID is required for e2b-desktop: sandboxes are matched across the E2B team
# COMPUTER_E2B_TEMPLATE=desktop  # optional custom template built from "desktop"
# E2B_DOMAIN=  # only when not using the default E2B cluster

# Optional Jev interaction choices: off (default), sample scripted decisions, or live SDK.
JEV_MODE=off
# live sends the latest user message, agent-written context and candidate choices to TypeSafe;
# see docs/demos/jev-generative-ui.md#what-live-mode-sends-to-typesafe
# TYPESAFE_API_KEY=  # server-only; required for JEV_MODE=live
# JEV_MODEL=jev-1.13.0

# ---------------- 0Siri (0SIRI-SPEC.md §22-0 부록 B) ----------------
# 서버가 사용자에게 보이는 주소 (초대 링크·앱 설정). 도메인은 나중에 정한다.
# PUBLIC_BASE_URL=http://localhost:8787
# 세션 서명 키 (createAuth 가 DATA_DIR 에 자동 생성하므로 보통 비워 둔다)
# SESSION_SECRET=
# 관리자 시드 — 기동 시 없으면 만든다. 코드에 전화·비밀번호를 박지 않는다
# ADMIN_PHONE=
# ADMIN_PASSWORD=
# 워커(팀 런타임) 이미지 레지스트리 — 8단계 도커 프로비저닝
# REGISTRY_URL=
# 0Siri 웹 빌드 폴더 — expo export --platform web 결과를 API 와 같은 포트에서 낸다 (비우면 API 만)
# WEB_DIST=apps/mobile/dist/web
# TEAM_PROVISIONER_ENABLED=true   # false 면 큐만 쌓이고 컨테이너는 뜨지 않는다 (docker 없는 머신)
# 서버 임베딩 (EmbeddingGemma 2 ONNX q8 텍스트 전용). 첫 호출 때 내려받아 캐시한다
# EMBED_MODEL=onnx-community/embeddinggemma-2-ONNX
# EMBED_DTYPE=q8
# EMBED_DIM=768
# EMBED_CACHE_DIR=~/.cache/osiri-models
# 티어별 모델 (없으면 MODEL 로 통일) · 단가표(원/1M 토큰, 없으면 절감액 "측정 중")
# MODEL_TIER2=
# MODEL_TIER3=
# MODEL_TIER4=
# MODEL_PRICES_KRW={"vendor/model":{"in":1000,"out":4000}}
# BYOK 구독 OAuth 연결 — 기본 닫힘 (§13)
# BYOK_OAUTH_ENABLED=false
# 팀 런타임 컨테이너에 주입되는 값 (서버가 넣는다 — 수동 실행 시에만)
# OSIRI_API_URL=http://127.0.0.1:8787
# OSIRI_WORKER_TOKEN=
# TEAM_YAML=teams/legal-marketing.yaml
# OSIRI_PUBLISH=<mcp-server-id>:<tool>
# TEAM_INTERVAL_MS=600000
